# ============================================
# 图4.7 文档解析与入库流程图
# ============================================
@startuml 文档解析与入库流程图
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam defaultFontSize 11

title 图4.7 文档解析与入库流程图

start

:管理员上传文档;\n(PDF/Word/TXT/Markdown);

if (格式验证通过?) then (否)
  :返回错误;
  stop
else (是)
endif

:解析文档提取文本;

:文本分块处理;\n(生成chunks);

repeat
  :批量向量化处理;\n(DashScope API);
  
  :写入数据库;\n(PostgreSQL + MySQL);
  
repeat while (还有未处理批次?) is (是)
->;否

:更新任务状态完成;

stop

note bottom
  分块策略:
  - 固定大小/句子/段落/递归
  向量化: DashScope text-embedding-v4 (1024维)
end note

@enduml

# ============================================
# 图4.8 系统E-R图
# ============================================
@startuml 系统E-R图
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam linetype ortho
skinparam entity {
  BackgroundColor LightYellow
  BorderColor #333333
  FontSize 10
}

title 图4.8 系统E-R图

entity "用户\nUser" as User {
  id: PK
  username, email
  password_hash
}

entity "健康档案\nHealthProfile" as HealthProfile {
  id: PK
  user_id: FK
  age, gender, bmi
}

entity "饮食偏好\nDietPreference" as DietPreference {
  id: PK
  user_id: FK
  taste_preference
}

entity "健康目标\nHealthGoal" as HealthGoal {
  id: PK
  user_id: FK
  goal_type
}

entity "对话记录\nChatRecord" as ChatRecord {
  id: PK
  user_id: FK
  question, answer
}

entity "食谱\nRecipe" as Recipe {
  id: PK
  name, category
  steps
}

entity "食材\nIngredient" as Ingredient {
  id: PK
  name, category
}

entity "食谱食材关联\nRecipeIngredient" as RecipeIngredient {
  id: PK
  recipe_id, ingredient_id: FK
  amount, unit
}

entity "营养知识\nNutritionKnowledge" as NutritionKnowledge {
  id: PK
  title, content
  category
}

entity "知识嵌入\nKnowledgeEmbedding" as KnowledgeEmbedding {
  id: PK
  knowledge_id: FK
  chunk_text, embedding
}

' 关系定义
User ||--o| HealthProfile : "1:1"
User ||--o| DietPreference : "1:1"
User ||--o{ HealthGoal : "1:N"
User ||--o{ ChatRecord : "1:N"

Recipe ||--o{ RecipeIngredient : ""
Ingredient ||--o{ RecipeIngredient : ""

NutritionKnowledge ||--o{ KnowledgeEmbedding : "1:N"

@enduml

