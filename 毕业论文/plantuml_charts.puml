# ============================================
# 图4.3 用户注册登录流程图
# ============================================
@startuml 用户注册登录流程图
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam defaultFontSize 12

title 用户注册登录流程图

start

partition "用户注册流程" {
  :用户填写注册信息;\n(用户名/邮箱/手机号、密码);
  
  :前端表单验证;\n(密码长度6-50字符、\n邮箱格式校验);
  
  if (验证通过?) then (否)
    :提示用户修正输入;
    stop
  else (是)
    :POST /api/v1/auth/register;
  endif
  
  :Pydantic模型验证;\n(数据有效性检查);
  
  if (至少提供一种联系方式?) then (否)
    :返回错误 422;\n"用户名/邮箱/手机号至少一种";
    stop
  else (是)
  endif
  
  if (用户名或邮箱已存在?) then (是)
    :返回错误 400;\n"用户名已存在"或"邮箱已注册";
    stop
  else (否)
  endif
  
  :bcrypt.hashpw() 密码哈希加密;\n(生成Salt, 应用工作因子);
  
  :写入 MySQL users表;\n(username, email, phone,\npassword_hash, created_at);
  
  :返回注册成功响应;\n{success: true, data: user_info};
}

partition "用户登录流程" {
  :用户提交登录凭据;\n(用户名/邮箱/手机号 + 密码);
  
  :POST /api/v1/auth/login;
  
  :根据凭据类型查询users表;\n(username/email/phone);
  
  if (用户存在?) then (否)
    :返回错误 400;\n"用户不存在";
    stop
  else (是)
  endif
  
  :bcrypt.checkpw()\n验证密码;
  
  if (密码正确?) then (否)
    :返回错误 400;\n"密码错误";
    stop
  else (是)
  endif
  
  :生成JWT Token;\n(Header: HS256算法声明;\nPayload: user_id + exp(24h);\nSignature: 密钥签名);
  
  :返回登录成功响应;\n{success: true,\n data: {token, user_info}};
}

partition "Token认证机制" {
  :客户端保存Token;\n(LocalStorage);
  
  :后续请求携带Token;\n(Authorization: Bearer {token});
  
  :FastAPI依赖注入\nverify_token();
  
  if (Token有效?) then (否)
    if (Token过期?) then (是)
      :返回错误 401;\n"Token已过期，请重新登录";
    else (否)
      :返回错误 401;\n"无效的Token";
    endif
    stop
  else (是)
    :解析Token获取user_id;\n(注入current_user);
    :访问受保护资源;
  endif
}

stop

note right
  JWT Token结构:
  - Header: {"alg": "HS256"}
  - Payload: {"sub": user_id, "exp": timestamp}
  - Signature: HMACSHA256(Header.Payload, secret)
  - 默认有效期: 24小时
end note

note left
  密码安全:
  - 使用bcrypt算法
  - 自动引入随机Salt
  - 工作因子可配置
  - 抵御彩虹表攻击
end note

@enduml

# ============================================
# 图4.4 营养咨询对话流程图
# ============================================
@startuml 营养咨询对话流程图
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam defaultFontSize 12

title 营养咨询对话流程图

start

:用户输入营养咨询问题;\n(自然语言);

partition "前端处理" {
  :验证输入内容非空;
  
  :POST /api/v1/chat/message;\n(Authorization: Bearer {token});
}

partition "后端认证" {
  :verify_token() 验证JWT;
  
  if (Token有效?) then (否)
    :返回错误 401;\n"认证失败";
    stop
  else (是)
  endif
  
  :获取当前用户user_id;
}

partition "上下文管理" {
  :查询 MySQL chat_records表;\n(按user_id, 按created_at倒序);
  
  :获取最近N轮对话历史;\n(N由系统配置决定);
  
  if (存在历史对话?) then (是)
    :转换为LLM消息格式;\n([{"role": "user", "content": "..."},\n {"role": "assistant", "content": "..."}]);
  else (否)
    :空历史对话列表;
  endif
}

partition "LLM调用" {
  :组装消息列表;\n(系统提示词 + 历史对话 + 当前问题);
  
  note right
    系统提示词示例:
    "你是一个专业的营养顾问..."
    提供科学、准确的营养建议
  end note
  
  :调用豆包大模型API;\n(llm_service.chat_completion());
  
  if (API调用成功?) then (否)
    :返回错误 500;\n"AI服务暂时不可用";
    stop
  else (是)
  endif
  
  :获取AI生成的回答;\n(answer文本);
}

partition "数据存储" {
  :写入 MySQL chat_records表;\n(user_id, question, answer,\ncreated_at);
  
  :更新对话记录计数;
}

partition "响应返回" {
  :返回对话响应;\n{success: true,\n data: {answer, timestamp}};
}

partition "前端展示" {
  :接收AI回答;
  
  :更新对话界面;\n(显示用户问题和AI回答);
  
  :滚动到底部显示最新消息;
}

stop

note bottom
  上下文管理策略:
  - 最近N轮对话作为上下文
  - 确保模型理解对话连贯性
  - N值根据模型上下文窗口调整
  - 避免超出Token限制
end note

note left
  对话记录存储:
  - 表: chat_records
  - 字段: id, user_id, question, answer, created_at
  - 索引: user_id (加速按用户查询)
  - 排序: created_at DESC (最新对话优先)
end note

@enduml

# ============================================
# 图4.5 RAG食谱推荐流程图
# ============================================
@startuml RAG食谱推荐流程图
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam defaultFontSize 12

title RAG食谱推荐流程图

start

:用户提交食谱推荐请求;\n(饮食偏好、已有食材列表);

partition "前端处理" {
  :收集用户输入;\n(口味偏好、饮食类型、\n过敏食物、已有食材);
  
  :POST /api/v1/recipes/ai-recommend;\n(Authorization: Bearer {token});
}

partition "后端认证" {
  :verify_token() 验证JWT;
  
  if (Token有效?) then (否)
    :返回错误 401;
    stop
  else (是)
  endif
  
  :获取当前用户user_id;
}

partition "用户数据获取" {
  :查询 user_health_profile表;\n(年龄、性别、身高、体重、\n活动水平、健康状况);
  
  :计算BMI;\n(BMI = 体重 / 身高²);
  
  :查询 user_diet_preferences表;\n(口味偏好、饮食类型、\n过敏食物、禁忌食物);
  
  :查询 user_health_goals表;\n(目标类型、目标体重、\n每日热量目标);
  
  if (健康档案存在?) then (是)
    :获取完整健康数据;
  else (否)
    :使用默认值;
  endif
}

partition "RAG知识检索" {
  :将用户需求转换为查询向量;\n(调用 DashScope text-embedding-v4);
  
  :在 PostgreSQL knowledge_vectors表;\n执行语义相似度搜索;
  
  :SQL: ORDER BY embedding <=> query_embedding;\nLIMIT top_k;
  
  if (相似度 > 阈值?) then (是)
    :筛选相关知识片段;\n(相似度 > 0.8);
  else (否)
    :返回空知识列表;
  endif
  
  note right
    检索内容类型:
    - 营养搭配原则
    - 食材搭配禁忌
    - 季节性饮食建议
    - 特殊人群饮食指南
  end note
}

partition "LLM食谱生成" {
  :组装Prompt;\n(
    系统提示词 +
    用户健康档案 +
    用户饮食偏好 +
    用户健康目标 +
    已有食材列表 +
    RAG检索到的知识片段
  );
  
  note right
    Prompt示例结构:
    "根据以下用户信息生成食谱:
    - 年龄: 25岁, 性别: 男
    - BMI: 22.5 (正常)
    - 目标: 增肌
    - 偏好食材: 鸡胸肉, 西兰花
    - 过敏: 花生
    - 营养知识: 高蛋白饮食建议..."
  end note
  
  :调用豆包大模型API;\n(llm_service.chat_completion());
  
  if (API调用成功?) then (否)
    :返回错误 500;\n"AI服务暂时不可用";
    stop
  else (是)
  endif
  
  :解析AI响应;\n提取食谱结构数据;\n(食谱名称、食材清单、\n烹饪步骤、营养分析);
}

partition "结果返回" {
  :返回食谱推荐结果;\n{success: true,\n data: {\n   recipes: [...],\n   nutrition_analysis: "..." }};
}

partition "前端展示" {
  :渲染食谱卡片;\n(显示食谱名称、食材、步骤);
  
  :显示营养分析;\n(热量、蛋白质、脂肪等);
  
  :提供保存/收藏功能;
}

stop

note bottom
  RAG (检索增强生成) 优势:
  1. 结合权威营养知识,提高建议准确性
  2. 减少模型幻觉,提供可溯源信息
  3. 支持动态知识库更新,无需重新训练模型
  4. 个性化推荐,基于用户具体情况
end note

note left
  数据库查询:
  - MySQL: 用户健康数据
  - PostgreSQL: 向量知识检索
  - 双数据库协同工作
  - 通过SQLAlchemy ORM抽象
end note

@enduml

# ============================================
# 图4.6 食材识别处理流程图
# ============================================
@startuml 食材识别处理流程图
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam defaultFontSize 11

title 图4.6 食材识别处理流程图

start

:上传食材图片;\n(文件或URL);

:JWT认证;

:Base64编码图片;\n或直接使用URL;

:调用Qwen-VL模型;\n(DashScope API);

:解析识别结果;\n(食材名称+营养信息);

